# Build output
/bin/
# Binaries built into the repo root, not the cmd/ source directories.
/strata-server
/strata-cli

# Engine data directories. Manifest, CURRENT, and LOCK are anchored so they
# only match a data directory at the repo root, never a source file elsewhere.
/data/
*.sst
*.wal
/MANIFEST-*
/CURRENT
/LOCK

# Scratch directories from the T2.2 sync benchmarks. They are created on the
# repository's own filesystem because fsync is a no-op on the tmpfs that backs
# TMPDIR, and a crashed run leaves one behind.
syncer-*/

# Profiles and coverage
*.prof
# T1.4 commits its baseline profiles, so the raw pprof files under docs/ are
# exempt: the SVG flamegraphs are unreadable by pprof, and a profile nobody can
# reopen cannot be compared against a Phase 8 capture.
!docs/profiles/*.prof
coverage.out
coverage.html

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
